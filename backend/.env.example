# Copiar a ".env" y ajustar según el entorno.

# --- Servidor ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (debe coincidir con lo que creaste en pgAdmin) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=melo_pets
PGUSER=melo_admin
PGPASSWORD=melo_pets_dev

# --- Autenticación ---
# Generar uno propio en producción, por ejemplo con: openssl rand -hex 32
JWT_SECRET=cambiar_este_secreto_en_produccion_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h